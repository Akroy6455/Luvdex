# Copy this file to ".env.local" (for your computer) and fill in the values.
# On Vercel, add the same two names under Project → Settings → Environment Variables.
# Both values are PUBLIC by design. NEVER put the Supabase "secret" / "service_role" key here.

# Supabase → your project → Connect (or Project Settings → API Keys)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Google Maps Platform → Keys & Credentials (browser key restricted to your domains) and Map Management (Map ID)
EXPO_PUBLIC_GOOGLE_MAPS_KEY=
EXPO_PUBLIC_GOOGLE_MAP_ID=

# ── Phone apps (Phase 6) ─────────────────────────────────────────────
# Google sign-in IDs (Google Cloud → APIs & Services → Credentials). Client IDs are public.
# Web client ID: the same one Supabase's Google provider uses.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iPhone client ID (type "iOS", bundle ID app.luvdex)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Android-only Google Maps key (restricted to app.luvdex + the Play signing SHA-1). Build-time only.
GOOGLE_MAPS_ANDROID_KEY=
# Expo project ID (from `eas init`) and owner (Expo organization), set once the Expo account exists.
EAS_PROJECT_ID=
EXPO_OWNER=
