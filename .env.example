# Copy this file to ".env.local" (for your computer) and fill in the values.
# On Vercel, add the same two names under Project → Settings → Environment Variables.
# Both values are PUBLIC by design. NEVER put the Supabase "secret" / "service_role" key here.

# Supabase → your project → Connect (or Project Settings → API Keys)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
